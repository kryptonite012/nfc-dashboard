# ---------------------------------------------------------------------------
# VaultLedger API configuration. Copy to .env for local development.
# Never commit real secrets. In production, set these in your host's secret store.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL connection string
DATABASE_URL=postgresql://vaultledger:vaultledger_dev@localhost:5432/vaultledger

# Public URL of the web app (links in emails, allowed Origin for CSRF/CORS)
APP_URL=http://localhost:5173
# Extra comma-separated origins allowed to call the API with credentials (split deployments only)
EXTRA_ALLOWED_ORIGINS=

# Secret used to HMAC one-time codes. Generate with: openssl rand -base64 48
TOKEN_PEPPER=change-me-to-a-long-random-value-at-least-32-chars

# Cookies: must be true whenever the site is served over HTTPS (forced in production)
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs and rate limiting)
TRUST_PROXY=0

# Sessions
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12
REMEMBER_ME_DAYS=30
SESSION_ROTATION_MINUTES=15
REAUTH_WINDOW_MINUTES=10

# Email delivery: "smtp" (real delivery) or "outbox" (development only: writes to MAIL_OUTBOX_DIR)
EMAIL_TRANSPORT=outbox
EMAIL_FROM="VaultLedger <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_OUTBOX_DIR=.mail-outbox

# SMS delivery for phone verification / phone sign-in:
#   "disabled" (phone features hidden), "twilio" (real delivery), "outbox" (development only)
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
SMS_OUTBOX_DIR=.sms-outbox
REQUIRE_PHONE_ON_SIGNUP=false
DEFAULT_PHONE_REGION=IN

# Check new passwords against Have I Been Pwned (k-anonymity; only a 5-char hash prefix is sent)
HIBP_ENABLED=false

# Optional: absolute or relative path to the built web app (apps/web/dist) to serve it from the API
WEB_DIST_DIR=
