{
  "name": "vaultledger",
  "version": "1.0.0",
  "private": true,
  "description": "VaultLedger — Secure Item & Price Manager",
  "author": "kryptonite012 <finster749@gmail.com>",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "npm run dev --workspace @vaultledger/api & npm run dev --workspace @vaultledger/web",
    "build": "npm run build --workspace @vaultledger/web && npm run build --workspace @vaultledger/api",
    "start": "npm run start --workspace @vaultledger/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @vaultledger/api",
    "db:deploy": "npm run db:deploy --workspace @vaultledger/api",
    "db:seed": "npm run db:seed --workspace @vaultledger/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "@playwright/test": "1.64.1"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
